{
  "name": "JavaScript and TypeScript",
  "languages": ["javascript", "typescript", "jsx", "tsx"],
  "snippets": {
    "Console log": {
      "prefix": "log",
      "body": "console.log(${1});",
      "description": "console.log"
    },
    "Console error": {
      "prefix": "err",
      "body": "console.error(${1});",
      "description": "console.error"
    },
    "Function": {
      "prefix": "fn",
      "body": ["function ${1:name}(${2}) {", "\t$0", "}"],
      "description": "Function declaration"
    },
    "Async function": {
      "prefix": "afn",
      "body": ["async function ${1:name}(${2}) {", "\t$0", "}"],
      "description": "Async function"
    },
    "Arrow function": {
      "prefix": "arrow",
      "body": ["const ${1:name} = (${2}) => {", "\t$0", "};"],
      "description": "Arrow function in a constant"
    },
    "Import": {
      "prefix": "imp",
      "body": "import ${2:name} from \"${1:module}\";",
      "description": "Default import"
    },
    "Named import": {
      "prefix": "impn",
      "body": "import { ${2} } from \"${1:module}\";",
      "description": "Named import"
    },
    "Export function": {
      "prefix": "expf",
      "body": ["export function ${1:name}(${2}) {", "\t$0", "}"],
      "description": "Exported function"
    },
    "For of": {
      "prefix": "forof",
      "body": ["for (const ${2:item} of ${1:items}) {", "\t$0", "}"],
      "description": "for...of loop"
    },
    "Map": {
      "prefix": "map",
      "body": "${1:items}.map((${2:item}) => ${0})",
      "description": "Array map"
    },
    "Try catch": {
      "prefix": "try",
      "body": ["try {", "\t$1", "} catch (${2:error}) {", "\t$0", "}"],
      "description": "Try and catch"
    },
    "Fetch JSON": {
      "prefix": "fetchj",
      "body": [
        "const ${1:response} = await fetch(${2:url});",
        "if (!${1:response}.ok) {",
        "\tthrow new Error(`Request failed: \\${${1:response}.status}`);",
        "}",
        "const ${3:data} = await ${1:response}.json();"
      ],
      "description": "Fetch and read JSON"
    },
    "Class": {
      "prefix": "class",
      "body": ["class ${1:Name} {", "\tconstructor(${2}) {", "\t\t$0", "\t}", "}"],
      "description": "Class"
    },
    "Describe": {
      "prefix": "desc",
      "body": ["describe(\"${1:subject}\", () => {", "\t$0", "});"],
      "description": "Test group"
    },
    "Test": {
      "prefix": "test",
      "body": ["test(\"${1:does something}\", () => {", "\t$0", "});"],
      "description": "Test case"
    },
    "Timeout": {
      "prefix": "sto",
      "body": ["setTimeout(() => {", "\t$0", "}, ${1:1000});"],
      "description": "setTimeout"
    }
  }
}
