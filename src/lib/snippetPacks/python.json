{
  "name": "Python",
  "languages": ["python"],
  "snippets": {
    "Main guard": {
      "prefix": "main",
      "body": [
        "def main() -> None:",
        "\t${1:pass}",
        "",
        "",
        "if __name__ == \"__main__\":",
        "\tmain()"
      ],
      "description": "main function and guard"
    },
    "Function": {
      "prefix": "def",
      "body": ["def ${1:name}(${2}) -> ${3:None}:", "\t${0:pass}"],
      "description": "Function with return type"
    },
    "Async function": {
      "prefix": "adef",
      "body": ["async def ${1:name}(${2}) -> ${3:None}:", "\t${0:pass}"],
      "description": "Async function"
    },
    "Class": {
      "prefix": "class",
      "body": ["class ${1:Name}:", "\tdef __init__(self${2}) -> None:", "\t\t${0:pass}"],
      "description": "Class with __init__"
    },
    "Dataclass": {
      "prefix": "dc",
      "body": ["@dataclass", "class ${1:Name}:", "\t${2:field}: ${3:str}"],
      "description": "Dataclass"
    },
    "Property": {
      "prefix": "prop",
      "body": ["@property", "def ${1:name}(self) -> ${2:str}:", "\treturn self._${1:name}"],
      "description": "Property"
    },
    "Import from": {
      "prefix": "from",
      "body": "from ${1:module} import ${2:name}",
      "description": "from ... import"
    },
    "With open": {
      "prefix": "with",
      "body": ["with open(${1:path}, encoding=\"utf-8\") as ${2:file}:", "\t${0:pass}"],
      "description": "Open a file"
    },
    "Try except": {
      "prefix": "try",
      "body": ["try:", "\t${1:pass}", "except ${2:Exception} as ${3:error}:", "\t${0:raise}"],
      "description": "try and except"
    },
    "For": {
      "prefix": "for",
      "body": ["for ${1:item} in ${2:items}:", "\t${0:pass}"],
      "description": "for loop"
    },
    "List comprehension": {
      "prefix": "lc",
      "body": "[${1:item} for ${1:item} in ${2:items}]",
      "description": "List comprehension"
    },
    "Pytest test": {
      "prefix": "test",
      "body": ["def test_${1:something}() -> None:", "\t${0:assert True}"],
      "description": "pytest test function"
    }
  }
}
