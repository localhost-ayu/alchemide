{
  "name": "Rust",
  "languages": ["rust"],
  "snippets": {
    "Main": {
      "prefix": "main",
      "body": ["fn main() {", "\t$0", "}"],
      "description": "Main function"
    },
    "Function": {
      "prefix": "fn",
      "body": ["fn ${1:name}(${2}) -> ${3:()} {", "\t$0", "}"],
      "description": "Function"
    },
    "Public function": {
      "prefix": "pfn",
      "body": ["pub fn ${1:name}(${2}) -> ${3:()} {", "\t$0", "}"],
      "description": "Public function"
    },
    "Function returning Result": {
      "prefix": "fnr",
      "body": ["fn ${1:name}(${2}) -> Result<${3:()}, ${4:Error}> {", "\t$0", "\tOk(())", "}"],
      "description": "Function returning Result"
    },
    "Struct": {
      "prefix": "struct",
      "body": [
        "#[derive(Debug, Clone)]",
        "pub struct ${1:Name} {",
        "\tpub ${2:field}: ${3:String},",
        "}"
      ],
      "description": "Struct with derive"
    },
    "Enum": {
      "prefix": "enum",
      "body": [
        "#[derive(Debug, Clone, PartialEq, Eq)]",
        "pub enum ${1:Name} {",
        "\t${2:Variant},",
        "}"
      ],
      "description": "Enum with derive"
    },
    "Impl": {
      "prefix": "impl",
      "body": ["impl ${1:Type} {", "\t$0", "}"],
      "description": "Impl block"
    },
    "Impl trait": {
      "prefix": "implt",
      "body": ["impl ${1:Trait} for ${2:Type} {", "\t$0", "}"],
      "description": "Trait implementation"
    },
    "Match": {
      "prefix": "match",
      "body": [
        "match ${1:value} {",
        "\t${2:pattern} => ${3:todo!()},",
        "\t_ => ${0:todo!()},",
        "}"
      ],
      "description": "Match expression"
    },
    "If let": {
      "prefix": "iflet",
      "body": ["if let Some(${1:value}) = ${2:option} {", "\t$0", "}"],
      "description": "if let Some"
    },
    "For": {
      "prefix": "for",
      "body": ["for ${1:item} in ${2:items} {", "\t$0", "}"],
      "description": "for loop"
    },
    "Print": {
      "prefix": "println",
      "body": "println!(\"{${1}}\");",
      "description": "println! with an inline argument"
    },
    "Test": {
      "prefix": "test",
      "body": ["#[test]", "fn ${1:it_works}() {", "\t$0", "}"],
      "description": "Test function"
    },
    "Tests module": {
      "prefix": "tmod",
      "body": [
        "#[cfg(test)]",
        "mod tests {",
        "\tuse super::*;",
        "",
        "\t#[test]",
        "\tfn ${1:it_works}() {",
        "\t\t$0",
        "\t}",
        "}"
      ],
      "description": "Tests module"
    }
  }
}
